  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig-cjs.json",
    "clean": "rm -rf ./dist",
    "prepublishOnly": "yarn build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "prettier": "prettier --config .prettierrc --write .",
